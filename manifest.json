{
  "manifest_version": 3,
  "name": "Glow para RosarioGarage",
  "short_name": "Glow RosarioGarage",
  "version": "0.1.0",
  "description": "Mejoras no oficiales para RosarioGarage: favoritos, avisos vistos, ordenar el listado y contacto rápido en cada aviso.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://dolarapi.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Glow para RosarioGarage",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.rosariogarage.com/*", "https://rosariogarage.com/*"],
      "css": ["content.css"],
      "js": ["early.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.rosariogarage.com/*", "https://rosariogarage.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
